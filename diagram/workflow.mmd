```mermaid
flowchart TD
    %% Styling and Classes
    classDef admin fill:#ECFDF5,stroke:#10B981,stroke-width:2px,color:#065F46;
    classDef ai fill:#F5F3FF,stroke:#8B5CF6,stroke-width:2px,color:#5B21B6;
    classDef rules fill:#ECFDF5,stroke:#059669,stroke-width:2px,color:#064E3B;
    classDef human fill:#FEF3C7,stroke:#F59E0B,stroke-width:2px,color:#92400E;
    classDef flag fill:#FEF2F2,stroke:#EF4444,stroke-width:2px,color:#991B1B;

    %% Step 1: Admin Setup
    Step1["1. Category & Criteria Setup<br/>(Admin configures weights & mandatory gates; saves Version v1.0)"]:::admin
    
    %% Step 2: Upload
    Step2["2. Proposal Upload & Ingestion<br/>(Reviewer uploads contractor PDF & selects category)"]:::rules
    
    %% Step 3: AI Extraction
    Step3["3. AI Structured Extraction<br/>(LLM parses untrusted text to JSON facts & citations)"]:::ai
    
    %% Injection Check Branch
    SecCheck{"Prompt Injection<br/>Detected in text?"}:::ai
    SecFlag["Flag Security Alert<br/>(Ignore internal commands e.g. Proposal C; Log event)"]:::flag
    
    %% Step 4: Mandatory Gates
    Step4{"4. Mandatory Compliance Gate<br/>• Ontario Licence held by bidder?<br/>• WSIB & $5M Insurance?<br/>• Budget <= $260k?"}:::rules
    Ineligible["Status: INELIGIBLE<br/>(Fails mandatory requirement)"]:::flag
    FlaggedMandatory["Status: FLAGGED<br/>(Ambiguous / Subcontractor licence unconfirmed e.g. Proposal B)"]:::flag
    
    %% Step 5: Weighted Scoring
    Step5{"5. Complete Scoring Data Available?<br/>• Timeline committed within 16 weeks?<br/>• Complete proposal parameters?"}:::rules
    FlaggedTimeline["Status: FLAGGED<br/>(Timeline TBD e.g. Proposal D; refuse to guess)"]:::flag
    CalcScores["Compute Weighted Score (0-100)<br/>• Experience (30%) • Price (25%)<br/>• Timeline (15%) • Warranty (15%)<br/>• Team & Approach (15%)"]:::rules
    
    %% Step 6: Output
    Step6["6. Generate Ranked Triage<br/>(ranking.json: Ranked, Flagged, Scores & Explanations)"]:::rules
    
    %% Step 7: Human Review
    Step7["7. Human Review & Verification<br/>(Reviewer inspects citations, investigates flags, logs overrides)"]:::human
    
    %% Step 8: Final Decision & Audit
    Step8["8. Final Contract Award<br/>(Authorized procurement decision-maker awards contract)"]:::human
    Step9["9. Immutable Audit Log<br/>(Snapshot of criteria version, raw text, AI output, overrides, decision)"]:::rules

    %% Re-evaluation Loop
    CriteriaChange{"Criteria Changed<br/>by Admin?"}:::admin
    NewVersion["Create Criteria Version v2.0<br/>(Preserve v1.0 audit log; re-run scoring safely)"]:::admin

    %% Connections
    Step1 --> Step2
    Step2 --> Step3
    Step3 --> SecCheck
    SecCheck -- Yes --> SecFlag
    SecCheck -- No --> Step4
    SecFlag --> Step4
    
    Step4 -- Fails --> Ineligible
    Step4 -- Unclear / Missing --> FlaggedMandatory
    Step4 -- Pass --> Step5
    
    Step5 -- Missing Timeline / Facts --> FlaggedTimeline
    Step5 -- All Facts Present --> CalcScores
    
    CalcScores --> Step6
    FlaggedMandatory --> Step6
    FlaggedTimeline --> Step6
    Ineligible --> Step6
    
    Step6 --> Step7
    Step7 --> Step8
    Step8 --> Step9
    
    Step9 -. Criteria Updated .-> CriteriaChange
    CriteriaChange --> NewVersion
    NewVersion --> Step5
```
